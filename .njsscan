# njsscan configuration for VoiceIsolate Pro
# https://github.com/ajinabraham/njsscan

ignore-paths:
  - node_modules
  - public/lib
  - build
  - android
  - ios
  - fastlane
  - tests
  - notebooks

# The _mlCall timeout in app.js uses Math.floor/Math.min/Math.max to guarantee
# a bounded integer, but njsscan's taint analysis flags the payload source.
# This is a false positive — the value is never executed as code.
ignore-rules:
  - node_taint_sink
  - node_vm_code_injection
