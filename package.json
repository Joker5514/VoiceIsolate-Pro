{
  "name": "voiceisolate-pro",
  "version": "24.0.0",
  "type": "module",
  "description": "Studio-grade voice isolation platform. 32-stage Deca-Pass DSP pipeline with hybrid ML + classical spectral processing. Mobile-ready via Capacitor for Android & iOS.",
  "private": true,
  "main": "electron/main.cjs",
  "keywords": [
    "audio",
    "dsp",
    "voice-isolation",
    "noise-reduction",
    "web-audio",
    "machine-learning",
    "mobile",
    "android",
    "ios",
    "capacitor"
  ],
  "author": "Randy Jordan <joker5514@users.noreply.github.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Joker5514/VoiceIsolate-Pro.git"
  },
  "homepage": "https://voice-isolate-pro.vercel.app",
  "bugs": {
    "url": "https://github.com/Joker5514/VoiceIsolate-Pro/issues"
  },
  "scripts": {
    "postinstall": "node scripts/setup-ort.js && node scripts/setup-three.js",
    "setup:ort": "node scripts/setup-ort.js",
    "setup:three": "node scripts/setup-three.js",
    "setup:electron": "node node_modules/electron/install.js",
    "predev": "node scripts/sync-src.js",
    "prestart": "node scripts/sync-src.js",
    "sync:src": "node scripts/sync-src.js",
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "npx serve public -l 3000 --cors",
    "build": "node scripts/build.mjs",
    "lint": "eslint public/app/app.js public/app/dsp-worker.js public/app/dsp-processor.js public/app/ml-worker.js public/app/vip-enhancements.js public/landing.js src server electron",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment=node",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment=node --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment=node --watch",
    "lint:fix": "eslint public/app/app.js public/app/dsp-worker.js public/app/dsp-processor.js public/app/ml-worker.js public/app/vip-enhancements.js public/landing.js src server --fix",
    "validate": "node scripts/validate.js",
    "worklets:hash": "node scripts/hash-worklets.js",
    "worklets:verify": "node scripts/verify-worklets.js",
    "worklets:verify:build": "node scripts/verify-worklets.js --require-build",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment=node --coverage",
    "test:live": "node scripts/live-smoke.cjs",
    "test:landing": "node scripts/landing-smoke.cjs",
    "pretest:landing": "playwright install chromium",
    "test:engineer": "node scripts/engineer-rt-smoke.cjs",
    "pretest:engineer": "playwright install chromium",
    "pretest:live": "playwright install chromium",
    "build:mobile": "pnpm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:build": "pnpm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:win": "node scripts/android-build-win.mjs",
    "android:release": "pnpm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:bundle": "pnpm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "ios:sync": "pnpm run build && npx cap sync ios",
    "ios:build": "pnpm run build && npx cap sync ios && npx cap open ios",
    "ios:pods": "cd ios/App && pod install",
    "mobile:dev": "pnpm run build && npx cap sync && echo 'Synced to both platforms'",
    "mobile:sync-version": "node scripts/sync-mobile-version.js",
    "mobile:version": "node scripts/sync-mobile-version.js",
    "postversion": "node scripts/sync-mobile-version.js",
    "models:download": "bash scripts/download-models.sh",
    "models:upload": "python scripts/upload_models_to_vercel_blob.py",
    "models:upload:blob": "node scripts/upload-to-vercel-blob.mjs",
    "models:validate": "node scripts/validate-onnx-models.js",
    "models:wire": "python3 scripts/wire-blob-models.py",
    "models:diarization": "node scripts/download-diarization-models.mjs",
    "models:upload:diarization": "node scripts/upload-diarization-blob.mjs",
    "electron:dev": "cross-env VIP_ELECTRON_DEV=1 electron .",
    "electron:start": "electron .",
    "build:electron": "node scripts/electron-build-win.mjs",
    "build:electron:dir": "node scripts/electron-build-win.mjs --dir"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.0.0",
    "@vercel/blob": "^0.27.0",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+/public/app/.+\\.js$": "<rootDir>/scripts/jest-cjs-transform.cjs"
    },
    "collectCoverageFrom": [
      "public/app/dsp-core.js",
      "public/app/pipeline-state.js",
      "public/app/ring-buffer.js",
      "src/core/ring-buffer-constants.js",
      "src/core/OverlapAddAccumulator.js",
      "src/core/DesktopBridge.js",
      "src/core/DesktopModelCache.js",
      "src/core/ModelCacheBridge.js",
      "src/pipeline/LivePipeline.js",
      "src/pipeline/MLWorkerHost.js",
      "src/core/audio-config.js",
      "src/core/BufferPool.js",
      "src/core/ModelManifest.js",
      "public/app/ml-worker.js",
      "public/app/batch-processor.js",
      "public/app/analytics.js",
      "api-routes/monetization.js",
      "api-routes/sync.js"
    ],
    "forceExit": true,
    "openHandlesTimeout": 1000
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.0",
    "@vercel/analytics": "^2.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "onnxruntime-web": "1.25.1",
    "three": "0.184.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=8.4.1",
      "@xmldom/xmldom": ">=0.9.10",
      "basic-ftp": ">=5.3.0",
      "@tootallnate/once": ">=3.0.1",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "flatted": ">=3.4.2",
      "brace-expansion": ">=1.1.13",
      "tar": ">=6.2.1",
      "ws": ">=8.21.0",
      "tough-cookie": ">=4.1.4",
      "semver": ">=7.5.4",
      "word-wrap": ">=1.2.4",
      "ip": ">=2.0.1",
      "undici": ">=8.5.0",
      "got": ">=14.4.2",
      "cross-spawn": ">=7.0.5",
      "micromatch": ">=4.0.8",
      "esbuild": ">=0.25.0",
      "form-data": ">=4.0.6",
      "qs": ">=6.15.2",
      "ip-address": ">=10.1.1"
    }
  },
  "overrides": {
    "tar": ">=6.2.1",
    "ws": ">=8.21.0",
    "tough-cookie": ">=4.1.4",
    "semver": ">=7.5.4",
    "word-wrap": ">=1.2.4",
    "ip": ">=2.0.1",
    "undici": ">=8.5.0",
    "cross-spawn": ">=7.0.5",
    "micromatch": ">=4.0.8",
    "brace-expansion": ">=1.1.13",
    "flatted": ">=3.4.2",
    "form-data": ">=4.0.6",
    "protobufjs": ">=8.4.1",
    "qs": ">=6.15.2",
    "ip-address": ">=10.1.1"
  }
}
