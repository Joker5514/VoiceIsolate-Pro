# VoiceIsolate Pro — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control. Never hardcode any of these in source.

# ─── Security (Layer 0) ───────────────────────────────────────────────────────
# JWT signing secret for license + sync tokens (HMAC-SHA256, min 32 chars).
# This is the ONLY server secret the code reads for token signing — see
# api-routes/monetization.js and api-routes/sync.js. REQUIRED in production:
# the server throws on boot if it is unset. Generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
LICENSE_JWT_SECRET=

# Note: there is no separate ADMIN_SECRET / JWT_SECRET / WEBHOOK_IDEMPOTENCY_KEY.
# No admin route exists, and Stripe webhook idempotency is keyed off the Stripe
# event.id (see api-routes/monetization.js), not a configured key.

# ─── Stripe (only needed for paywall features) ────────────────────────────────
# https://dashboard.stripe.com/apikeys — test keys for local development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...

# ─── RevenueCat (Android / iOS in-app purchases) ──────────────────────────────
# PUBLIC SDK keys (safe on-device, not in source control). Blank for web-only.
RC_API_KEY_ANDROID=
RC_API_KEY_IOS=

# ─── Model storage (Vercel Blob — only for uploading/managing large models) ───
BLOB_READ_WRITE_TOKEN=
BLOB_DEMUCS_URL=

# ─── Deployment Secrets ───────────────────────────────────────────────────────
# Vercel deployment token for CI/CD automation
# Obtain from: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel organization ID (found in team settings or project settings)
# Obtain from: https://vercel.com/[team-name]/settings
VERCEL_ORG_ID=

# Vercel project ID (found in project settings)
# Obtain from: https://vercel.com/[team-name]/[project-name]/settings
VERCEL_PROJECT_ID=

# Apple ID for iOS app distribution (App Store Connect)
# Your Apple Developer account email used for app signing and distribution
# Obtain from: https://developer.apple.com/account
APPLE_ID=

# Google Play JSON key for Android app distribution
# Service account JSON key for Google Play Console API access
# Obtain from: https://play.google.com/console → Setup → API access → Service accounts
# Download the JSON key file and either:
#   1. Set this to the file path: /path/to/service-account-key.json
#   2. Or set to the base64-encoded JSON content for CI/CD
GOOGLE_PLAY_JSON_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (production only; in-memory store otherwise) ────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/voiceisolate
