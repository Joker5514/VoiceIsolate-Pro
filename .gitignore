public/app/models/demucs_v4_*.onnx
public/models/*.onnx

# Parallel redesign workspace (not part of production tree)
Voice enhancement/

# Agent / IDE scratch (not part of the shipped product)
.qodo/
.jules/
.Jules/
.claude/

# Local Vercel CLI metadata
.vercel/

# Jupyter notebooks (local experiments)
notebooks/

